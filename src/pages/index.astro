---
import '../styles/global.css';

const routes = [
  {
    name: 'Niigata City Culture and Food Route',
    duration: '4 hours (half day)',
    price: 'JPY 36,000 per group (1-4 guests)',
    meeting: 'JR Niigata Station or central Niigata hotel',
    season: 'Available all year',
    walking: 'Easy, about 1.5 km on flat streets',
    highlights: [
      'Hakusan Shrine',
      'Former Saito Family Residence',
      'Furumachi walking area',
      'Local lunch guidance'
    ],
    driveRoute: [
      'JR Niigata Station',
      'Hakusan Shrine',
      'Former Saito Family Residence',
      'Furumachi district',
      'JR Niigata Station'
    ],
    driveDistance: 'about 9 km total',
    driveTime: 'about 30 to 40 minutes total driving',
    mapUrl:
      'https://www.google.com/maps/dir/?api=1&origin=Niigata+Station&destination=Niigata+Station&waypoints=Hakusan+Shrine+Niigata|Former+Saito+Family+Residence+Niigata|Furumachi+Niigata&travelmode=driving',
    idealFor: 'First-time visitors and senior travelers who prefer a relaxed pace.'
  },
  {
    name: 'Yahiko and Teradomari Coast Route',
    duration: '8 hours (full day)',
    price: 'JPY 62,000 per group (1-4 guests)',
    meeting: 'JR Niigata Station or central Niigata hotel',
    season: 'Best from spring to autumn',
    walking: 'Moderate, about 3 km total',
    highlights: [
      'Yahiko Shrine',
      'Yahiko mountain views',
      'Teradomari fish market street',
      'Seafood lunch guidance'
    ],
    driveRoute: [
      'JR Niigata Station',
      'Yahiko Shrine',
      'Yahiko ropeway area (weather dependent)',
      'Teradomari Fish Market Street',
      'JR Niigata Station'
    ],
    driveDistance: 'about 90 km total',
    driveTime: 'about 2 hours 30 minutes total driving',
    mapUrl:
      'https://www.google.com/maps/dir/?api=1&origin=Niigata+Station&destination=Niigata+Station&waypoints=Yahiko+Shrine+Niigata|Yahiko+Ropeway|Teradomari+Fish+Market+Street&travelmode=driving',
    idealFor: 'Guests who want nature, shrine culture, and coastal scenery in one day.'
  },
  {
    name: 'Sado Island Heritage and Scenic Route',
    duration: '9 hours on Sado Island (ferry time excluded)',
    price: 'JPY 78,000 per group (1-4 guests)',
    meeting: 'Ryotsu Port, Sado Island',
    season: 'Best from spring to autumn',
    walking: 'Moderate, about 2.5 km total',
    highlights: [
      'Sado Gold Mine related site',
      'Shukunegi historic village',
      'Coastal scenic drive',
      'Local food guidance'
    ],
    driveRoute: [
      'Ryotsu Port',
      'Sado Gold Mine area',
      'Shukunegi village',
      'Ryotsu Port'
    ],
    driveDistance: 'about 95 km total on Sado Island',
    driveTime: 'about 2 hours 40 minutes total driving',
    mapUrl:
      'https://www.google.com/maps/dir/?api=1&origin=Ryotsu+Port&destination=Ryotsu+Port&waypoints=Sado+Kinzan|Shukunegi&travelmode=driving',
    idealFor: 'Travelers who want a unique full-day experience with history and landscapes.'
  }
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Niigata Prefecture only. Licensed private guide interpreter service in English for Western visitors. Clear route, price, and time details."
    />
    <meta property="og:title" content="Niigata Private Guide | Licensed Interpreter Guide" />
    <meta
      property="og:description"
      content="Easy-to-read private tour website for Western guests visiting Niigata, including senior-friendly pacing options."
    />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>Niigata Private Guide | Niigata Only English Tours</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-row">
        <a class="brand" href="#top">Niigata Private Guide</a>
        <nav class="nav">
          <a href="#routes">Routes</a>
          <a href="#details">Details</a>
          <a href="#contact">Contact</a>
        </nav>
      </div>
    </header>

    <main id="top">
      <section class="hero section">
        <div class="container hero-grid">
          <div class="hero-copy" data-animate>
            <p class="eyebrow">Licensed Guide Interpreter | Niigata, Japan</p>
            <h1>
              Niigata Prefecture only.<br />
              Private English tours<br />
              for Western visitors.
            </h1>
            <p class="lead">
              A nationally licensed guide interpreter offers clear, calm, and easy-to-follow support.
              Tour pacing is adjusted for senior guests and families.
            </p>
            <ul class="hero-points">
              <li>Area: Niigata Prefecture only</li>
              <li>Language: English</li>
              <li>Group size: 1 to 4 guests per booking</li>
            </ul>
            <div class="cta-row">
              <a class="button" href="#contact">Check availability</a>
              <a class="button secondary" href="#routes">View 3 routes</a>
            </div>
          </div>

          <aside class="hero-panel" data-animate style="--delay: 160ms;">
            <h2>Senior-friendly support</h2>
            <ul>
              <li>Large-text schedule available on request</li>
              <li>More breaks can be included</li>
              <li>Shorter walking plans available</li>
              <li>Simple pre-tour meeting instructions</li>
            </ul>
          </aside>
        </div>
      </section>

      <section class="section scenic-section">
        <div class="container">
          <h2>Niigata scenery in your background</h2>
          <p class="section-copy">
            The page background uses real Niigata sightseeing photos: Bandai Bridge, Yahiko Shrine, and Sado Gold Mine area.
          </p>
          <div class="scenic-grid" data-animate>
            <article class="scenic-card scenic-city">
              <h3>Bandai Bridge</h3>
              <p>Niigata City</p>
            </article>
            <article class="scenic-card scenic-yahiko">
              <h3>Yahiko Shrine</h3>
              <p>Yahiko</p>
            </article>
            <article class="scenic-card scenic-sado">
              <h3>Sado Gold Mine Area</h3>
              <p>Sado Island</p>
            </article>
          </div>
        </div>
      </section>

      <section id="routes" class="section">
        <div class="container">
          <h2>Three recommended routes</h2>
          <p class="section-copy">
            All prices are tax included guide fees per group. Transport, entrance fees, meals, and ferry tickets are separate.
          </p>

          <div class="route-grid">
            {
              routes.map((route, index) => (
                <article class="route-card" data-animate style={`--delay: ${index * 120 + 120}ms;`}>
                  <h3>{route.name}</h3>

                  <dl class="route-meta">
                    <div>
                      <dt>Duration</dt>
                      <dd>{route.duration}</dd>
                    </div>
                    <div>
                      <dt>Price</dt>
                      <dd class="price">{route.price}</dd>
                    </div>
                    <div>
                      <dt>Meeting point</dt>
                      <dd>{route.meeting}</dd>
                    </div>
                    <div>
                      <dt>Best season</dt>
                      <dd>{route.season}</dd>
                    </div>
                    <div>
                      <dt>Walking level</dt>
                      <dd>{route.walking}</dd>
                    </div>
                  </dl>

                  <h4>Highlights</h4>
                  <ul class="highlights">
                    {route.highlights.map((spot) => <li>{spot}</li>)}
                  </ul>

                  <h4>Driving route</h4>
                  <ol class="drive-route">
                    {route.driveRoute.map((stop) => <li>{stop}</li>)}
                  </ol>
                  <p class="drive-meta">
                    <strong>Estimated driving:</strong> {route.driveDistance} / {route.driveTime}
                  </p>
                  <a class="map-link" href={route.mapUrl} target="_blank" rel="noopener noreferrer">
                    Open driving map
                  </a>

                  <p class="ideal-for">Best for: {route.idealFor}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section id="details" class="section alt">
        <div class="container detail-grid">
          <article class="info-card" data-animate>
            <h2>Included</h2>
            <ul>
              <li>Licensed guide interpreter service</li>
              <li>Pre-tour planning call or message</li>
              <li>Day-of itinerary support</li>
              <li>English explanations of local culture and history</li>
            </ul>
          </article>

          <article class="info-card" data-animate style="--delay: 120ms;">
            <h2>Not included</h2>
            <ul>
              <li>Transport costs (train, taxi, ferry, etc.)</li>
              <li>Entrance tickets</li>
              <li>Meals and drinks</li>
              <li>Travel insurance</li>
            </ul>
          </article>

          <article class="info-card" data-animate style="--delay: 240ms;">
            <h2>Booking information</h2>
            <ul>
              <li>Start time options: 9:00, 10:00, or 11:00</li>
              <li>Payment: bank transfer or credit card</li>
              <li>Cancellation: free until 7 days before, 50% from 6 to 2 days, 100% on the day before and day of tour</li>
              <li>Service language: English</li>
            </ul>
          </article>
        </div>
      </section>

      <section id="contact" class="section">
        <div class="container contact-box" data-animate>
          <h2>Contact and reservation</h2>
          <p>
            Please send your preferred date, number of guests, route choice, and walking comfort level.
            We reply within 24 hours.
          </p>
          <p class="contact-line"><strong>Email:</strong> guide.niigata@example.com</p>
          <p class="contact-line"><strong>Tel:</strong> 025-000-0000 (9:00-18:00)</p>
          <a class="button" href="mailto:guide.niigata@example.com?subject=Niigata Tour Request">
            Send email inquiry
          </a>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>Niigata Private Guide | Licensed English Guide Service in Niigata</p>
      </div>
    </footer>
  </body>
</html>
